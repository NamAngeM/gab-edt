# ==============================================================================
# GAB-EDT — secrets de production (copier en .env, ne JAMAIS committer .env)
# ==============================================================================
# Nom de domaine public (le DNS doit pointer vers ce serveur : HTTPS automatique)
DOMAIN=edt.example.ga

# Base de données
DB_PASSWORD=

# Secret de signature des jetons, partagé API / frontend : `openssl rand -base64 48`
JWT_SECRET=

# SMTP (réinitialisation de mot de passe)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.ga

# Premier compte SUPER_ADMIN (créé au premier démarrage, mot de passe ≥ 12 caractères).
# Retirer le mot de passe de ce fichier une fois le compte créé.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
