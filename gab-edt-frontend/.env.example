# ==============================================================================
# GAB-EDT Frontend — variables d'environnement (copier en .env.local en dev)
# ==============================================================================
# URL de l'API Spring vue depuis le serveur Next.js (jamais exposée au navigateur)
BACKEND_URL=http://localhost:8080/api/v1
# Même valeur que JWT_SECRET du backend : sert à vérifier les jetons dans le proxy.
# Obligatoire en production (sans elle, tous les accès protégés sont refusés).
JWT_SECRET=
# Durées des cookies de session (doivent correspondre au backend), en millisecondes
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
# WebSocket (notifications temps réel) — même site que l'application pour que le cookie soit envoyé
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
# Afficher les écrans encore en maquette (démonstration uniquement)
NEXT_PUBLIC_SHOW_PREVIEW_FEATURES=false
