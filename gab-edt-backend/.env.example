# ==============================================================================
# GAB-EDT — Variables d'environnement (exemple)
# ==============================================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env avec des secrets réels.
# ==============================================================================

# ── Base de données ───────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/gabedt
DB_USERNAME=gabedt
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Obligatoire hors dev, 32 octets minimum (`openssl rand -base64 48`), identique côté frontend
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── Application ───────────────────────────────────────────────────────────────
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@gab-edt.ga

# ── Premier SUPER_ADMIN (créé au démarrage s'il n'existe pas ; mot de passe ≥ 12 caractères)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
