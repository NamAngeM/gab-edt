# ==============================================================================
# GAB-EDT — Variables d'environnement (exemple)
# ==============================================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env avec des secrets réels.
# ==============================================================================

# ── Base de données ───────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/gabedt
DB_USERNAME=gabedt
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Stockage fichiers ────────────────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
